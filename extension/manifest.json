{
  "manifest_version": 2,
  "name": "Places DB Viewer",
  "version": "0.1.0",
  "description": "A tool to help engineers inspect the contents of places.sqlite",
  "browser_specific_settings": {
    "gecko": {
      "id": "places-db-viewer@mozilla.com",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "tabs"
  ],
  "browser_action": {
    "default_title": "Places DB Viewer"
  },
  "experiment_apis": {
    "places": {
      "schema": "experiments/places/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "experiments/places/api.js",
        "paths": [
          [
            "experiments",
            "places"
          ]
        ]
      }
    }
  }
}
